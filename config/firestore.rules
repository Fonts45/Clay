rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function profileValid(p) {
      return p.keys().hasAll(['name','headline','bio','resume','github','linkedin'])
        && p.keys().hasOnly(['name','headline','bio','resume','github','linkedin','photo','username','education','currentStudies','careers','pronouns','website','social3','social4','company'])
        && (!('pronouns' in p) || (p.pronouns is string && p.pronouns.size() <= 40))
        && (!('website' in p) || (p.website is string && p.website.size() <= 2000))
        && (!('social3' in p) || (p.social3 is string && p.social3.size() <= 2000))
        && (!('social4' in p) || (p.social4 is string && p.social4.size() <= 2000))
        && (!('company' in p) || (p.company is string && p.company.size() <= 160))
        && (!('username' in p) || (p.username is string && (p.username == '' || p.username.matches('^[A-Za-z0-9_.-]{3,40}$'))))
        && (!('education' in p) || (p.education is string && p.education.size() <= 2000))
        && (!('currentStudies' in p) || (p.currentStudies is string && p.currentStudies.size() <= 2000))
        && (!('careers' in p) || (p.careers is string && p.careers.size() <= 1000))
        && p.name is string && p.name.size() <= 100
        && (!('photo' in p) || (p.photo is string && p.photo.size() <= 180000))
        && p.headline is string && p.headline.size() <= 160
        && p.bio is string && p.bio.size() <= 600
        && p.resume is string && p.resume.size() <= 2000
        && p.github is string && p.github.size() <= 2000
        && p.linkedin is string && p.linkedin.size() <= 2000;
    }
    match /learningSpaces/{uid} {
      allow get: if owner(uid);
      allow list: if false;
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['profile','courses','projects','published','initialized','initialTopic','updatedAt'])
        && profileValid(request.resource.data.profile)
        && (!('username' in request.resource.data.profile) || request.resource.data.profile.username == '' || (request.resource.data.profile.username.matches('[a-z0-9_.-]{3,40}') && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.profile.username)).data.uid == uid))
        && request.resource.data.courses is list && request.resource.data.courses.size() <= 100
        && request.resource.data.projects is list && request.resource.data.projects.size() <= 40
        && request.resource.data.published == true
        && request.resource.data.initialized is bool
        && request.resource.data.updatedAt is number;
      allow delete: if owner(uid);
    }
    // Reserva única, consistente com o perfil salvo na mesma transação.
    match /presence/{uid}/sessions/{session} {
      allow read: if request.auth != null;
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['online','lastSeen'])
        && request.resource.data.online is bool
        && request.resource.data.lastSeen == request.time;
      allow delete: if owner(uid);
    }
    match /usernames/{handle} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null && handle.matches('[a-z0-9_.-]{3,40}')
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/learningSpaces/$(request.auth.uid)).data.profile.username == handle;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid
        && request.resource.data == resource.data
        && getAfter(/databases/$(database)/documents/learningSpaces/$(request.auth.uid)).data.profile.username == handle;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/learningSpaces/$(request.auth.uid)).data.profile.username != handle;
    }
    match /publicPortfolios/{uid} {
      allow get: if true;
      allow list: if false;
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['profile','projects','learning','updatedAt'])
        && profileValid(request.resource.data.profile)
        && request.resource.data.projects is list && request.resource.data.projects.size() <= 40
        && request.resource.data.learning is list && request.resource.data.learning.size() <= 100
        && request.resource.data.updatedAt is number
        && getAfter(/databases/$(database)/documents/learningSpaces/$(uid)).data.published == true;
      allow delete: if owner(uid);
    }
  }
}
